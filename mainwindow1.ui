    color: white; /* White text */
    border: none;
    border-radius: 5px;
    padding: 5px 10px;
}

QGroupBox QPushButton:hover {
    background-color: #0056b3; /* Darker blue on hover */
}

QGroupBox QPushButton:pressed {
    background-color: #004494; /* Even darker blue when pressed */
}
